{
  "manifest_version": 3,
  "name": "AI 额度看板 · Chrome 连接器",
  "version": "0.1.0",
  "description": "通过当前 Chrome 的 Cursor 登录会话，只读查询 Grok Bot 额度并发送给本机 AI 额度看板。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://cursor.com/dashboard*"],
    "js": ["protocol.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "action": {
    "default_title": "AI 额度看板连接状态",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
